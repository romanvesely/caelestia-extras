+                                        }
+                                    }
+                                }
+                            }
+                        }
+                    }
+                }
+
+                StyledText {
+                    anchors.centerIn: parent
+                    anchors.verticalCenterOffset: header.implicitHeight / 2
+                    visible: win.query !== "" && card.blocks.length === 0
+                    text: Tr.tr("No matches for \"%1\"").arg(win.query)
