+.pragma library
+
+// caelestia-extras (cheatsheet): key names for the chips and readable
+// labels for hyprlang binds without a description
+
+const MODS = {
+    shift: "Shift",
+    ctrl: "Ctrl",
+    control: "Ctrl",
+    alt: "Alt",
+    super: "Super",
+};
+
+// xkb altwin:swap_alt_win / swap_lalt_lwin: the key Hyprland calls SUPER is
+// labelled Alt on the keyboard and the other way round
+const SWAPPED = {
+    Alt: "Super",
+    Super: "Alt",
+};
+
+const KEYS = {
+    left: "←",
+    right: "→",
+    up: "↑",
+    down: "↓",
+    return: "Enter",
+    space: "Space",
+    tab: "Tab",
+    escape: "Esc",
+    delete: "Del",
+    backspace: "⌫",
+    backslash: "\\",
+    comma: ",",
+    period: ".",
+    minus: "−",
+    equal: "=",
+    page_up: "PgUp",
+    page_down: "PgDn",
+    print: "Print",
+    mouse_up: "Scroll ↑",
+    mouse_down: "Scroll ↓",
+    "mouse:272": "Left click",
+    "mouse:273": "Right click",
+    "mouse:274": "Middle click",
+    xf86audioplay: "Play",
+    xf86audiopause: "Pause",
+    xf86audionext: "Next",
+    xf86audioprev: "Prev",
+    xf86audiostop: "Stop",
+    xf86audiomute: "Mute",
+    xf86audiomicmute: "Mic mute",
+    xf86audioraisevolume: "Vol +",
+    xf86audiolowervolume: "Vol −",
+    xf86monbrightnessup: "Bright +",
+    xf86monbrightnessdown: "Bright −",
+};
+
+function keyLabel(key) {
+    const lower = key.toLowerCase();
+    if (KEYS[lower])
+        return KEYS[lower];
+    if (key.length === 1)
+        return key.toUpperCase();
+    return key.charAt(0).toUpperCase() + key.slice(1);
+}
+
+// chips always in this order, whatever the config says
+const MOD_ORDER = ["Ctrl", "Alt", "Shift", "Super"];
+
+function parse(combo, swapped) {
+    const mods = [];
+    let key = "";
+    for (const raw of combo.split("+")) {
+        const part = raw.trim();
+        const mod = MODS[part.toLowerCase()];
+        if (mod)
+            mods.push(swapped ? (SWAPPED[mod] ?? mod) : mod);
+        else if (part)
+            key = keyLabel(part);
+    }
+    mods.sort((x, y) => MOD_ORDER.indexOf(x) - MOD_ORDER.indexOf(y));
+    return { mods, key };
+}
+
+const ARROWS = ["←", "→", "↑", "↓"];
+
+// Same modifiers everywhere: "Super ← → ↑ ↓" (up to four keys).
+// Otherwise only the first alternative, the line would get too long.
+function chips(combos, swapped) {
+    const parsed = (combos ?? []).map(c => parse(c, swapped)).filter(c => c.key);
+    if (parsed.length === 0)
+        return [];
+
+    const sameMods = parsed.every(c => c.mods.join() === parsed[0].mods.join());
+    let keys = sameMods ? parsed.slice(0, 4).map(c => c.key) : [parsed[0].key];
+    // a set of arrows reads better as one chip
+    if (keys.length > 1 && keys.every(k => ARROWS.includes(k)))
+        keys = [keys.join(" ")];
+    return parsed[0].mods.concat(keys);
+}
+
+const DIRECTIONS = { l: "left", r: "right", u: "up", d: "down" };
+
+// hyprlang dispatcher + argument -> short English label
+function describe(dispatcher, arg) {
+    const a = (arg ?? "").trim();
+    const dir = DIRECTIONS[a] ?? a;
+    switch (dispatcher) {
+    case "exec":
+    case "execr":
+        return `Run ${a.split(/\s+/)[0].split("/").pop()}`;
+    case "workspace":
+        return `Workspace ${a}`;
+    case "movetoworkspace":
+        return `Move window to workspace ${a}`;
+    case "movetoworkspacesilent":
+        return `Send window to workspace ${a}`;
+    case "togglespecialworkspace":
+        return `Toggle special workspace ${a}`.trim();
+    case "killactive":
+        return "Close window";
+    case "togglefloating":
+        return "Toggle floating";
+    case "fullscreen":
+        return "Fullscreen";
+    case "pin":
+        return "Pin window";
+    case "movefocus":
+        return `Focus ${dir}`;
+    case "movewindow":
+        return a ? `Move window ${dir}` : "Drag window";
+    case "resizeactive":
+        return `Resize window ${a}`;
+    case "resizewindow":
+        return "Drag to resize";
+    case "global":
+        return a.split(":").pop().replace(/([a-z])([A-Z])/g, "$1 $2").replace(/^./, c => c.toUpperCase());
+    default:
+        return a ? `${dispatcher} ${a}` : dispatcher;
+    }
+}
+
+// key names as shown, for the search ("alt q" also finds a swapped Super + Q)
+function searchText(combos, swapped) {
+    return (combos ?? []).map(c => {
+        const p = parse(c, swapped);
+        return p.mods.concat(p.key).join(" ");
+    }).join(" ");
+}
